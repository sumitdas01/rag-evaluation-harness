# ==============================================================================
# Enterprise RAG Evaluation Harness - Environment Configuration
# ==============================================================================

# LLM API Configuration (Groq, OpenAI, or compatible API)
# Optional: If omitted, the harness operates in high-performance local extractive mode
LLM_API_KEY=your_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Local Open-Source Transformer Models (Runs on CPU/GPU via sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# CI/CD Quality Gate Threshold (%)
# Minimum acceptable answer accuracy required for builds to pass
EVAL_THRESHOLD=70.0
